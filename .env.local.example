# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=cole-a-chave-anon-aqui
SUPABASE_SERVICE_ROLE_KEY=cole-a-chave-service-role-aqui

# --- Auth (chaves de acesso) ---
# Senha unica do administrador
ADMIN_PASSWORD=trocar-essa-senha-do-admin
# Senha unica compartilhada por todos os vendedores
SELLER_PASSWORD=trocar-essa-senha-do-vendedor

# Segredo para assinar cookies (qualquer string longa e aleatoria)
SESSION_SECRET=gere-uma-string-aleatoria-bem-grande-aqui

# --- Ponte com o Jarvis (so o GAV usa; ver src/app/api/ca/receber) ---
# O Hub NAO fala com o Conta Azul: um app do CA aceita uma unica URL de
# redirecionamento e app "de producao" nao e reconhecido pela API v2. Quem fala
# com o Conta Azul e o Jarvis, e ele EMPURRA o espelho para /api/ca/receber.
# O sentido da ponte e de proposito: o endpoint exposto fica do lado que tem
# menos a perder se o segredo vazar.
# Tem de ser IDENTICO ao PONTE_HUB_SECRET configurado no Jarvis.
JARVIS_PONTE_SECRET=
